# Copy to .env for local development only. Never commit real secrets.
TRUSTVAULT_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
TRUSTVAULT_ADMIN_EMAIL=admin@example.com
TRUSTVAULT_DATA_DIR=./data
# For production, set this to a protected PEM file outside the web root:
# TRUSTVAULT_AUDIT_PRIVATE_KEY=/secure/path/trustvault-audit-key.pem
# APP_ENV=production
